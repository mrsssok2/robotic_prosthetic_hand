<?xml version="1.0"?>
<!-- Right hand in the style of an InMoov printed hand (white PLA, procedural meshes from scripts/gen_meshes.py).
     Frame: wrist at the palm origin, fingers point +Z, the palm faces -Y (viewed from -Y with the fingers up,
     +X is on the right, so the thumb is on +X and the little finger on -X). Finger flexion = rotation about +X
     (tips move toward -Y, over the palm). A forearm shell hangs below the wrist; the whole arm stands on a plate.

     Fingers: one tendon per finger -> MCP is commanded, PIP = K_PIP * MCP, DIP = K_DIP * MCP.
     Thumb: low on the palm's side, open pose points out sideways about 70 deg from the index finger. Closing swings it
            sideways across the front of the palm (thumb_swing, in the palm plane, about -Y) with a little opposition
            (thumb_opp, about the thumb's own X) while both segments curl toward the palm (thumb_mcp, thumb_ip).
            All four thumb joints follow the single thumb value (ratios below).

     Wrist: 2 DOF between the forearm and the palm, pronation/supination (about the forearm axis) then flexion/extension
            (about the transverse axis, +X like the finger flexion). Both pivot at the centre of the forearm's top face,
            WRIST_PIVOT below the palm origin, under a ball-joint dome (palm visual), so the palm's lower edges swing clear of
            the forearm over the whole range (test_geometry checks the clearance). Limits and pivot are repeated in hand_controller/shaping.py and
            hand_tracker/core/wrist.py.

     Gazebo Harmonic's DART ignores <mimic>, so in simulation every joint is position-driven and
     hand_controller applies the same ratios; <mimic> tags are used when sim_gazebo is false (RViz).
     Keep the numbers in the properties below in sync with hand_controller/shaping.py and scripts/dims.py
     (tests check both). xacro args: sim_gazebo, controllers_yaml, base_z. -->
<robot name="hand" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="sim_gazebo" default="false"/>
  <xacro:arg name="controllers_yaml" default=""/>
  <xacro:arg name="base_z" default="0.28"/>
  <!-- lift:=true puts a vertical prismatic joint (0..0.2 m) between the world and the palm, so a grasped
       object can be picked up off the table (grasp world). -->
  <xacro:arg name="lift" default="false"/>

  <xacro:property name="use_mimic" value="${'$(arg sim_gazebo)' != 'true'}"/>
  <xacro:property name="MCP_MAX" value="1.57"/>
  <xacro:property name="K_PIP" value="1.2"/>
  <xacro:property name="K_DIP" value="0.7"/>
  <xacro:property name="SWING_MAX" value="2.95"/>
  <xacro:property name="OPP_MAX" value="0.43"/>
  <xacro:property name="TMCP_MAX" value="0.55"/>
  <xacro:property name="TIP_MAX" value="0.5"/>
  <xacro:property name="PALM_H" value="0.085"/>
  <xacro:property name="WRIST_PRON_MAX" value="1.4"/>   <!-- +/-: pronation (+) / supination (-) -->
  <xacro:property name="WRIST_FLEX_MAX" value="1.0"/>   <!-- flexion  -->
  <xacro:property name="WRIST_EXT_MAX" value="1.0"/>    <!-- extension (lower limit is -this) -->
  <xacro:property name="WRIST_PIVOT" value="0.035"/>    <!-- pronation/flexion pivot (forearm top) this far below the palm origin; dims.py -->
  <xacro:property name="WRIST_EFFORT" value="3.0"/>
  <!-- grasping: joint effort limit = force limit of the closing fingers (N*m); fingertip radius ~9 mm, so
       0.25 N*m at the MCP is roughly 3-4 N at the tip -->
  <xacro:property name="FINGER_EFFORT" value="0.10"/>
  <xacro:property name="MESH" value="file://$(find hand_description)/meshes"/>

  <material name="pla"><color rgba="0.94 0.94 0.92 1"/></material>
  <material name="black"><color rgba="0.07 0.07 0.08 1"/></material>

  <!-- one printed segment: mesh along +Z of its link, collision = cylinder along the segment (friction is set with
       the <gazebo> mu1/mu2 below: URDF has no <surface>). Links of one model do not collide with each other
       (SDF self_collide is false), so the thumb passes through the fingers as in a fist; all touch the objects. -->
  <xacro:macro name="seg" params="name mesh seglen rad mass:=0.01">
    <link name="${name}">
      <visual>
        <geometry><mesh filename="${MESH}/${mesh}.obj"/></geometry>
        <material name="pla"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${seglen/2}"/>
        <geometry><cylinder radius="${rad}" length="${seglen}"/></geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="1e-6" iyy="1e-6" izz="1e-6" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <gazebo reference="${name}"><gravity>false</gravity><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
  </xacro:macro>

  <xacro:macro name="empty_link" params="name">
    <link name="${name}">
      <inertial>
        <mass value="0.005"/>
        <inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <gazebo reference="${name}"><gravity>false</gravity></gazebo>
  </xacro:macro>

  <!-- axis: rotation axis; master/k: mimic (only when use_mimic) -->
  <xacro:macro name="joint_r" params="name parent child xyz rpy:='0 0 0' axis:='1 0 0' lo:=0 hi master:='' k:=1.0 effort:=${FINGER_EFFORT}">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/><child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="${axis}"/>
      <limit lower="${lo}" upper="${hi}" effort="${effort}" velocity="8"/>
      <xacro:if value="${master != '' and use_mimic}"><mimic joint="${master}" multiplier="${k}" offset="0"/></xacro:if>
      <dynamics damping="0.01"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="finger" params="name x l1 l2 l3 r">
    <xacro:seg name="${name}_proximal" mesh="${name}_prox" seglen="${l1}" rad="${r}"/>
    <xacro:seg name="${name}_middle" mesh="${name}_mid" seglen="${l2}" rad="${r*0.84}"/>
    <xacro:seg name="${name}_distal" mesh="${name}_dist" seglen="${l3}" rad="${r*0.72}"/>
    <xacro:joint_r name="${name}_mcp" parent="palm" child="${name}_proximal" xyz="${x} 0 ${PALM_H}" hi="${MCP_MAX}"/>
    <xacro:joint_r name="${name}_pip" parent="${name}_proximal" child="${name}_middle" xyz="0 0 ${l1}"
                   hi="${MCP_MAX*K_PIP + 0.05}" master="${name}_mcp" k="${K_PIP}"/>
    <xacro:joint_r name="${name}_dip" parent="${name}_middle" child="${name}_distal" xyz="0 0 ${l2}"
                   hi="${MCP_MAX*K_DIP + 0.05}" master="${name}_mcp" k="${K_DIP}"/>
    <gazebo reference="${name}_distal">
      <sensor name="${name}_tip_contact" type="contact">
        <always_on>1</always_on><update_rate>100</update_rate>
        <contact><collision>${name}_distal_collision</collision></contact>
      </sensor>
    </gazebo>
  </xacro:macro>

  <link name="world"/>

  <!-- forearm shell hanging below the wrist + cuff: fixed to the base, the hand turns on top of it -->
  <link name="forearm">
    <visual>
      <geometry><mesh filename="${MESH}/forearm.obj"/></geometry>
      <material name="pla"/>
    </visual>
    <visual>
      <geometry><mesh filename="${MESH}/cuff.obj"/></geometry>
      <material name="pla"/>
    </visual>
    <inertial>
      <origin xyz="0 0 -0.1"/>
      <mass value="0.3"/>
      <inertia ixx="1e-3" iyy="1e-3" izz="1e-4" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="forearm"><gravity>false</gravity></gazebo>
  <xacro:empty_link name="wrist_roll_link"/>
  <xacro:empty_link name="wrist_flex_link"/>

  <link name="palm">
    <visual>   <!-- rounded palm -->
      <origin xyz="0 0 0.0425"/>
      <geometry><mesh filename="${MESH}/palm.obj"/></geometry>
      <material name="pla"/>
    </visual>
    <visual>   <!-- wrist ball joint: dome on the forearm + neck into the palm -->
      <geometry><mesh filename="${MESH}/wrist.obj"/></geometry>
      <material name="pla"/>
    </visual>
    <visual>   <!-- thenar pad the thumb is mounted on -->
      <origin xyz="0.036 -0.020 0.030"/>
      <geometry><mesh filename="${MESH}/thenar.obj"/></geometry>
      <material name="pla"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0425"/>
      <geometry><box size="0.09 0.031 0.085"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0425"/>
      <mass value="0.5"/>
      <inertia ixx="1e-3" iyy="1e-3" izz="1e-3" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <gazebo reference="palm"><gravity>false</gravity><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
  <xacro:if value="${'$(arg lift)' != 'true'}">
    <joint name="base" type="fixed">
      <parent link="world"/><child link="forearm"/>
      <origin xyz="0 0 ${$(arg base_z) - WRIST_PIVOT}"/>
    </joint>
  </xacro:if>
  <xacro:if value="${'$(arg lift)' == 'true'}">
    <!-- grasp world: the hand reaches over a table, palm DOWN, fingers pointing -Y (palm frame rotated +90 deg about X),
         so closing curls the fingers down around an object under the palm. base_z = palm height at lift = 0. -->
    <xacro:empty_link name="lift_carriage"/>
    <joint name="lift" type="prismatic">
      <parent link="world"/><child link="lift_carriage"/>
      <origin xyz="0 0 $(arg base_z)"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.06" upper="0.2" effort="200" velocity="0.5"/>
      <dynamics damping="1.0"/>
    </joint>
    <joint name="base" type="fixed">
      <parent link="lift_carriage"/><child link="forearm"/>
      <origin xyz="0 ${WRIST_PIVOT} 0" rpy="1.5707963 0 0"/>
    </joint>
  </xacro:if>

  <!-- wrist: pronation/supination about the forearm axis (-Z so that + = pronation), then flexion/extension; the forearm
       frame origin is the pivot, the palm hangs WRIST_PIVOT above it -->
  <xacro:joint_r name="wrist_pronation" parent="forearm" child="wrist_roll_link" xyz="0 0 0" axis="0 0 -1"
                 lo="${-WRIST_PRON_MAX}" hi="${WRIST_PRON_MAX}" effort="${WRIST_EFFORT}"/>
  <xacro:joint_r name="wrist_flexion" parent="wrist_roll_link" child="wrist_flex_link" xyz="0 0 0" axis="1 0 0"
                 lo="${-WRIST_EXT_MAX}" hi="${WRIST_FLEX_MAX}" effort="${WRIST_EFFORT}"/>
  <joint name="wrist_palm" type="fixed">
    <parent link="wrist_flex_link"/><child link="palm"/>
    <origin xyz="0 0 ${WRIST_PIVOT}"/>
  </joint>

  <xacro:if value="${'$(arg lift)' != 'true'}">
  <link name="stand">   <!-- black acrylic plate with an electronics block, like the printed hand's stand -->
    <visual>
      <origin xyz="0.03 0 0.004"/>
      <geometry><box size="0.20 0.11 0.008"/></geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0.085 0 0.029"/>
      <geometry><box size="0.075 0.05 0.042"/></geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <origin xyz="0.03 0 0.01"/>
      <mass value="1.0"/>
      <inertia ixx="1e-3" iyy="1e-3" izz="1e-3" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="stand_fixed" type="fixed">
    <parent link="world"/><child link="stand"/>
    <origin xyz="0 0 0"/>
  </joint>
  </xacro:if>

  <!-- index is next to the thumb (+X), little finger on the far side (-X) -->
  <xacro:finger name="little" x="-0.034"  l1="0.034" l2="0.021" l3="0.018" r="0.0075"/>
  <xacro:finger name="ring"   x="-0.0115" l1="0.042" l2="0.027" l3="0.020" r="0.0085"/>
  <xacro:finger name="middle" x="0.0115"  l1="0.046" l2="0.029" l3="0.022" r="0.0090"/>
  <xacro:finger name="index"  x="0.034"   l1="0.041" l2="0.026" l3="0.020" r="0.0085"/>

  <!-- ===== thumb: swing (sideways across the palm) -> opposition -> MCP flex -> IP flex ===== -->
  <xacro:empty_link name="thumb_mount"/>
  <joint name="thumb_mount_fixed" type="fixed">   <!-- CMC: low on the palm's side, on the thenar pad -->
    <parent link="palm"/><child link="thumb_mount"/>
    <origin xyz="0.046 -0.037 0.027"/>
  </joint>
  <xacro:empty_link name="thumb_swing_link"/>
  <xacro:seg name="thumb_meta" mesh="thumb_meta" seglen="0.034" rad="0.0098"/>
  <xacro:seg name="thumb_prox" mesh="thumb_prox" seglen="0.030" rad="0.0088"/>
  <xacro:seg name="thumb_dist" mesh="thumb_dist" seglen="0.024" rad="0.0068"/>
  <!-- swing about -Y: positive swings the tip sideways across the palm toward -X (the little finger).
       The 70 deg open angle (tilt from the index finger) is added after the joint, at thumb_opp; rotations about Y add. -->
  <xacro:joint_r name="thumb_swing" parent="thumb_mount" child="thumb_swing_link" xyz="0 0 0" axis="0 -1 0" hi="${SWING_MAX}"/>
  <!-- opposition about the thumb's own +X: tips the thumb out of the palm plane toward -Y (in front of the palm) -->
  <xacro:joint_r name="thumb_opp" parent="thumb_swing_link" child="thumb_meta" xyz="0 0 0" rpy="0 1.2217 0" hi="${OPP_MAX}"
                 master="thumb_swing" k="${OPP_MAX/SWING_MAX}"/>
  <!-- the two thumb segments curl about -X, toward +Y (the palm) -->
  <xacro:joint_r name="thumb_mcp" parent="thumb_meta" child="thumb_prox" xyz="0 0 0.034" axis="-1 0 0" hi="${TMCP_MAX}"
                 master="thumb_swing" k="${TMCP_MAX/SWING_MAX}"/>
  <xacro:joint_r name="thumb_ip" parent="thumb_prox" child="thumb_dist" xyz="0 0 0.030" axis="-1 0 0" hi="${TIP_MAX}"
                 master="thumb_swing" k="${TIP_MAX/SWING_MAX}"/>

  <gazebo reference="thumb_dist">
    <sensor name="thumb_tip_contact" type="contact">
      <always_on>1</always_on><update_rate>100</update_rate>
      <contact><collision>thumb_dist_collision</collision></contact>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg sim_gazebo)">
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
      <xacro:macro name="act" params="name">
        <joint name="${name}">
          <command_interface name="position"/>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"/>
        </joint>
      </xacro:macro>
      <xacro:macro name="act_finger" params="f"><xacro:act name="${f}_mcp"/><xacro:act name="${f}_pip"/><xacro:act name="${f}_dip"/></xacro:macro>
      <xacro:if value="${'$(arg lift)' == 'true'}"><xacro:act name="lift"/></xacro:if>
      <xacro:act_finger f="little"/><xacro:act_finger f="ring"/><xacro:act_finger f="middle"/><xacro:act_finger f="index"/>
      <xacro:act name="thumb_swing"/><xacro:act name="thumb_opp"/><xacro:act name="thumb_mcp"/><xacro:act name="thumb_ip"/>
      <xacro:act name="wrist_pronation"/><xacro:act name="wrist_flexion"/>
    </ros2_control>
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers_yaml)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
