<?xml version="1.0"?>
<package format="3">
  <name>hand_tracker</name>
  <version>0.1.0</version>
  <description>MediaPipe hand tracking: proportional finger curl and gestures.</description>
  <maintainer email="mrsssok222@gmail.com">S. Mahadev</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>hand_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
