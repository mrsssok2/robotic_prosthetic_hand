<?xml version="1.0"?>
<sdf version="1.10">
  <world name="hand_world">
    <!-- screenshot variant: adds a fixed camera in front of the palm on /camera/image -->
    <!-- no gravity: the hand is bolted to the world and the weak position controller would otherwise sag the thumb -->
    <gravity>0 0 0</gravity>
    <physics name="2ms" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gui fullscreen="0">
      <plugin filename="GzScene3D" name="3D View">
        <gz-gui>
          <title>Hand</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.55 0.55 0.55</ambient_light>
        <background_color>0.56 0.61 0.68</background_color>
        <camera_pose>-0.22 -0.85 0.30 0 0.07 1.3185</camera_pose>
      </plugin>
    </gui>

    <scene><ambient>0.7 0.7 0.7 1</ambient><background>0.56 0.61 0.68 1</background></scene>
    <model name="palm_camera">
      <static>true</static>
      <pose>-0.22 -0.85 0.30 0 0.07 1.3185</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>0.85</horizontal_fov>
            <image><width>800</width><height>600</height></image>
            <clip><near>0.05</near><far>5</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/camera/image</topic>
        </sensor>
      </link>
    </model>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.4 0.7 -0.5</direction>
    </light>
  </world>
</sdf>
